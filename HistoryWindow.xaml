<Window x:Class="Savings.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History" Height="600" Width="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="History" FontSize="19" FontWeight="Bold" Margin="0,0,0,14"/>

    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="12" Padding="18,14">
        <StackPanel>
          <TextBlock Text="Total VND saved" FontSize="12" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="VndTotal" FontSize="22" FontWeight="Bold"
                     Foreground="{StaticResource Vnd}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="12" Padding="18,14">
        <StackPanel>
          <TextBlock Text="Total USD saved" FontSize="12" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="UsdTotal" FontSize="22" FontWeight="Bold"
                     Foreground="{StaticResource Usd}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="12" Padding="6,4">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="Rows">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" Width="120"/>
                <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="12"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="13.5" FontWeight="SemiBold"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource Ghost}" Content="Export CSV" Click="Export_Click" Margin="0,0,8,0"/>
      <Button Style="{StaticResource Btn}" Content="Close" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
