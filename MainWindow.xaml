<Window x:Class="Savings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Savings"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Savings" Height="226" Width="440" MinHeight="170" MinWidth="300"
        Background="{StaticResource BgGrad}"
        WindowStyle="None" Topmost="True"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <!-- Our own chrome, because the window deliberately has no close button. Windows still owns the
       drag, the double-click to maximise and the resize edges. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="20" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- No title-bar row: the cards sit inside one even 20px margin, and that top margin is exactly the
       caption strip the window is dragged by. Any row here would push the cards down and leave a gap
       across the top that the other three sides do not have.

       The opening size is chosen to match what a card actually wants: with the green bar gone the card
       draws a 336x323 box — the gem and the currency and nothing else — so two of them plus the gap and
       the margins come to 440x226. Any taller and the Viewbox fits the cards to the width instead and
       leaves dead space above and below them. -->

  <Grid x:Name="Root">

    <!-- Two blooms and a vignette, lit in whatever colour each track is currently wearing.
         Behind everything and deaf to the mouse, so the whole strip stays draggable. -->
    <Grid Panel.ZIndex="-1" IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Center"
               Margin="-380,0,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush x:Name="BloomVnd">
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Center"
               Margin="0,0,-380,0">
        <Ellipse.Fill>
          <RadialGradientBrush x:Name="BloomUsd">
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <!-- A faint ruled floor under the blooms: it gives the light something to fall on, and fades
           out before it reaches the edges so the room never turns into graph paper. -->
      <Rectangle>
        <Rectangle.Fill>
          <DrawingBrush TileMode="Tile" Viewport="0,0,38,38" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
              <GeometryDrawing Brush="#09FFFFFF">
                <GeometryDrawing.Geometry>
                  <GeometryGroup>
                    <RectangleGeometry Rect="0,0,38,1"/>
                    <RectangleGeometry Rect="0,0,1,38"/>
                  </GeometryGroup>
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Rectangle.Fill>
        <Rectangle.OpacityMask>
          <RadialGradientBrush RadiusX="0.62" RadiusY="0.58">
            <GradientStop Color="#FF000000" Offset="0.15"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.OpacityMask>
      </Rectangle>

      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
            <GradientStop Color="#00000000" Offset="0.42"/>
            <GradientStop Color="#73000000" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- ============ MAIN MENU ============ -->
    <!-- Two compartments, one per currency, and nothing else. There was a logo above them once; the
         cards say which app this is perfectly well on their own. -->
    <Grid x:Name="MenuLayer" Margin="20" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="MenuScale" ScaleX="1" ScaleY="1"/>
      </Grid.RenderTransform>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <local:MenuCoin x:Name="VndTile" Grid.Column="0"/>
      <local:MenuCoin x:Name="UsdTile" Grid.Column="2"/>
    </Grid>

    <!-- ============ ONE CURRENCY ============ -->
    <Grid x:Name="FocusLayer" Margin="20" Visibility="Collapsed" Opacity="0"
          RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="FocusScale" ScaleX="0.84" ScaleY="0.84"/>
      </Grid.RenderTransform>

      <!-- Gem and glow scale together once the window is smaller than they are. -->
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
        <Grid Width="560" Height="580">
          <Ellipse x:Name="FocusGlow" Width="540" Height="540" Opacity="0.08"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
            <Ellipse.Effect>
              <BlurEffect Radius="120"/>
            </Ellipse.Effect>
          </Ellipse>

          <local:FocusView x:Name="Detail"/>
        </Grid>
      </Viewbox>
    </Grid>

    <!-- Sits over the whole window, edge to edge, and never takes the mouse. -->
    <local:Celebration x:Name="Cheer" Panel.ZIndex="20"/>
  </Grid>
</Window>
