<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for WinForms' NotifyIcon: WPF has no tray icon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Savings</AssemblyName>
    <RootNamespace>Savings</RootNamespace>
    <Product>Savings</Product>
    <Company>Savings</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>Savings.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Ship a single exe: no .pdb alongside it. -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms brings these in globally, where they collide with WPF's Brush, Point and
         UserControl in every file. Tray.cs imports what it needs by hand instead. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also carried as a WPF resource so the tray can load it without digging it out of the exe. -->
    <Resource Include="Savings.ico" />
  </ItemGroup>

</Project>
