<Window x:Class="Savings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="660" Width="470"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <Window.Resources>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>
  </Window.Resources>

  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock x:Name="HeadText" FontSize="19" FontWeight="Bold"/>
      <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="These settings apply to this coin only. The other coin is left untouched."/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,10,0">

        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="14" Padding="20,14,20,18">
          <StackPanel>
            <TextBlock Text="Lock after ticking a step" FontSize="14" FontWeight="Bold"/>
            <TextBlock Style="{StaticResource Lbl}"
                       Text="Minutes to wait before the next amount unlocks (0 = no lock)"/>
            <TextBox x:Name="CooldownBox"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Style="{StaticResource Ghost}" Content="20 min" Tag="20"   Click="Preset_Click"/>
              <Button Style="{StaticResource Ghost}" Content="1 hour" Tag="60"   Click="Preset_Click"/>
              <Button Style="{StaticResource Ghost}" Content="1 day"  Tag="1440" Click="Preset_Click"/>
              <Button Style="{StaticResource Ghost}" Content="1 week" Tag="10080" Click="Preset_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="14" Padding="20,14,20,18" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Schedule by multiplier" FontSize="14" FontWeight="Bold"/>
            <TextBlock Style="{StaticResource Lbl}" Text="First amount"/>
            <TextBox x:Name="StartBox"/>
            <TextBlock Style="{StaticResource Lbl}" Text="Multiplier per step"/>
            <TextBox x:Name="RatioBox"/>
            <TextBlock Style="{StaticResource Lbl}" Text="Total steps"/>
            <TextBox x:Name="StepsBox"/>
            <TextBlock Style="{StaticResource Lbl}" Text="Round to (0 = no rounding)"/>
            <TextBox x:Name="RoundBox"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="14" Padding="20,14,20,18" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Or paste your own list" FontSize="14" FontWeight="Bold"/>
            <TextBlock Style="{StaticResource Lbl}" TextWrapping="Wrap"
                       Text="One number per line. If this list is filled in, the formula above is ignored."/>
            <TextBox x:Name="CustomBox" Height="130" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
          </StackPanel>
        </Border>

        <Border Background="#12161C" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="14" Padding="18,14" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Preview" FontSize="12" Foreground="{StaticResource Muted}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Path x:Name="WarnIcon" Data="{StaticResource IconWarn}" Fill="{StaticResource Tier1}"
                    Width="17" Height="17" Stretch="Uniform" Visibility="Collapsed"
                    VerticalAlignment="Top" Margin="0,1,8,0"/>
              <TextBlock x:Name="PreviewText" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="14" Padding="20,14,20,16" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Ticked by mistake?" FontSize="14" FontWeight="Bold"/>
            <TextBlock Style="{StaticResource Lbl}" TextWrapping="Wrap"
                       Text="Rolls this track back one step and clears its lock."/>
            <Button x:Name="UndoBtn" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Left" Margin="0,4,0,0" Click="Undo_Click">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconUndo}" Width="16" Height="16" Stretch="Uniform"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" VerticalAlignment="Center"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock Text="Undo last step" Margin="9,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource Ghost}" Content="Refresh preview" Click="Preview_Click" Margin="0,0,8,0"/>
      <Button Style="{StaticResource Ghost}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
      <Button x:Name="SaveBtn" Style="{StaticResource Btn}" Content="Save" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
