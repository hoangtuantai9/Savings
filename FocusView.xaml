<UserControl x:Class="Savings.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Tick" TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="32"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#0E1116"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="72"/>
      <Setter Property="Height" Value="72"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="press" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <Ellipse x:Name="halo" Fill="{TemplateBinding Background}" Opacity="0.18" Margin="-10"/>
              <Ellipse Fill="{TemplateBinding Background}"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="halo" Property="Opacity" Value="0.45"/>
                <Setter TargetName="press" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="1.08" ScaleY="1.08"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="press" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.93" ScaleY="0.93"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The other half of the verdict. Same footprint as Tick so neither answer is hidden, but hollow
         and grey rather than a lit accent disc: admitting you did not make it should not be the thing
         the eye lands on first. -->
    <Style x:Key="Deny" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="72"/>
      <Setter Property="Height" Value="72"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="press" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <Ellipse x:Name="ring" Stroke="{StaticResource Muted}" StrokeThickness="2.4" Opacity="0.55"/>
              <Ellipse x:Name="fill" Fill="{StaticResource Muted}" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="Opacity" Value="1"/>
                <Setter TargetName="fill" Property="Opacity" Value="0.12"/>
                <Setter TargetName="press" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="1.08" ScaleY="1.08"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="press" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.93" ScaleY="0.93"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel VerticalAlignment="Center">

    <Grid Width="520" Height="470" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="Pulse" ScaleX="1" ScaleY="1"/>
          <RotateTransform x:Name="Tilt" Angle="0"/>
        </TransformGroup>
      </Grid.RenderTransform>

      <!-- Shockwave and rings, fired when a step is ticked off -->
      <Path x:Name="Wave" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform><ScaleTransform x:Name="WaveScale" ScaleX="0.6" ScaleY="0.6"/></Path.RenderTransform>
        <Path.Effect><BlurEffect Radius="60"/></Path.Effect>
      </Path>
      <Path x:Name="Burst1" StrokeThickness="3.5" StrokeLineJoin="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform><ScaleTransform x:Name="B1"/></Path.RenderTransform>
      </Path>
      <Path x:Name="Burst2" StrokeThickness="2.5" StrokeLineJoin="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform><ScaleTransform x:Name="B2"/></Path.RenderTransform>
      </Path>
      <Path x:Name="Burst3" StrokeThickness="2" StrokeLineJoin="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform><ScaleTransform x:Name="B3"/></Path.RenderTransform>
      </Path>
      <Path x:Name="Burst4" StrokeThickness="1.5" StrokeLineJoin="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform><ScaleTransform x:Name="B4"/></Path.RenderTransform>
      </Path>
      <Path x:Name="Burst5" StrokeThickness="1" StrokeLineJoin="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform><ScaleTransform x:Name="B5"/></Path.RenderTransform>
      </Path>

      <!-- Rim -->
      <Path x:Name="Track" Stroke="{StaticResource Rim}" StrokeThickness="11" StrokeLineJoin="Round"/>
      <Path x:Name="PlanArc" Opacity="0.32" StrokeThickness="11"
            StrokeLineJoin="Round" StrokeDashCap="Round"/>
      <Path x:Name="CoolArc" StrokeThickness="11"
            StrokeLineJoin="Round" StrokeDashCap="Round"/>

      <!-- Glowing head riding the end of the countdown edge -->
      <Ellipse x:Name="HeadDot" Width="20" Height="20" Opacity="0"
               HorizontalAlignment="Left" VerticalAlignment="Top">
        <Ellipse.RenderTransform>
          <TranslateTransform x:Name="HeadPos"/>
        </Ellipse.RenderTransform>
      </Ellipse>

      <!-- Coin body. Clipped to the diamond, so the hit area is the diamond too. -->
      <Grid x:Name="Face" Background="Transparent" Cursor="Hand"
            MouseLeftButtonUp="Face_Click" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <ScaleTransform x:Name="FlipScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Path x:Name="FaceFill" Fill="{StaticResource Card}" Stroke="{StaticResource Edge}"
              StrokeThickness="1" StrokeLineJoin="Round"/>
        <Path x:Name="Flash" Opacity="0"/>
        <!-- Its own layer rather than recolouring Flash: the bonus never borrows the tier's colour. -->
        <Path x:Name="IceFlash" Fill="{StaticResource Ice}" Opacity="0"/>

        <!-- SEALED -->
        <StackPanel x:Name="SealedPanel" VerticalAlignment="Center">
          <TextBlock x:Name="SealCurrency" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- REVEALED — the amount and the tick, nothing else -->
        <StackPanel x:Name="RevealPanel" Visibility="Collapsed" VerticalAlignment="Center">
          <Viewbox MaxWidth="220" Height="64" StretchDirection="DownOnly" Stretch="Uniform">
            <TextBlock x:Name="AmountText" FontSize="52" FontWeight="Bold"/>
          </Viewbox>
          <Button x:Name="TickBtn" Style="{StaticResource Tick}"
                  HorizontalAlignment="Center" Margin="0,24,0,0" Click="Tick_Click">
            <Path Data="{StaticResource IconCheck}" Stroke="#0E1116" StrokeThickness="3.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="34" Height="34" Stretch="Uniform"/>
          </Button>
        </StackPanel>

        <!-- SAVED -->
        <StackPanel x:Name="CheerPanel" Visibility="Collapsed" VerticalAlignment="Center">
          <Path x:Name="CheerMark" Data="{StaticResource IconCheck}" StrokeThickness="3.4"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Width="96" Height="96" Stretch="Uniform"
                HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
              <ScaleTransform x:Name="CheerScale" ScaleX="0.4" ScaleY="0.4"/>
            </Path.RenderTransform>
          </Path>
        </StackPanel>

        <!-- BONUS — column C, reached by tapping the ice stone outside the rim. Built like the revealed
             face so the two read as the same kind of offer, in a colour no tier can wear. -->
        <StackPanel x:Name="BonusPanel" Visibility="Collapsed" VerticalAlignment="Center">
          <Viewbox MaxWidth="220" Height="64" StretchDirection="DownOnly" Stretch="Uniform">
            <TextBlock x:Name="BonusText" FontSize="52" FontWeight="Bold"
                       Foreground="{StaticResource Ice}"/>
          </Viewbox>
          <Button x:Name="BonusBtn" Style="{StaticResource Tick}" Background="{StaticResource Ice}"
                  HorizontalAlignment="Center" Margin="0,24,0,0" Click="Bonus_Click">
            <Path Data="{StaticResource IconCheck}" Stroke="#06121A" StrokeThickness="3.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="34" Height="34" Stretch="Uniform"/>
          </Button>
        </StackPanel>

        <!-- VERDICT — the wait is over and it has to be answered before anything else happens.
             No question written anywhere: a tick and a cross on a gem that has just finished
             counting down can only be asking one thing. -->
        <StackPanel x:Name="VerdictPanel" Visibility="Collapsed" VerticalAlignment="Center"
                    Orientation="Horizontal" HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
          <StackPanel.RenderTransform>
            <ScaleTransform x:Name="AskScale" ScaleX="0.4" ScaleY="0.4"/>
          </StackPanel.RenderTransform>
          <Button x:Name="YesBtn" Style="{StaticResource Tick}" Width="84" Height="84"
                  Margin="0,0,15,0" Click="Yes_Click">
            <Path Data="{StaticResource IconCheck}" Stroke="#0E1116" StrokeThickness="3.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="40" Height="40" Stretch="Uniform"/>
          </Button>
          <Button x:Name="NoBtn" Style="{StaticResource Deny}" Width="84" Height="84"
                  Margin="15,0,0,0" Click="No_Click">
            <Path Data="{StaticResource IconCross}" Stroke="{StaticResource Muted}" StrokeThickness="3.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="36" Height="36" Stretch="Uniform"/>
          </Button>
        </StackPanel>

        <!-- ROLLED BACK — the step just banked is being taken away again. -->
        <StackPanel x:Name="FellPanel" Visibility="Collapsed" VerticalAlignment="Center">
          <Path x:Name="FellMark" Data="{StaticResource IconUndo}" Stroke="{StaticResource Muted}"
                StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                StrokeLineJoin="Round" Width="92" Height="92" Stretch="Uniform"
                HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
              <ScaleTransform x:Name="FellScale" ScaleX="1.3" ScaleY="1.3"/>
            </Path.RenderTransform>
          </Path>
        </StackPanel>

        <!-- WAITING -->
        <!-- A padlock and the clock, and not a word of explanation: a countdown under a lock says
             what it is on its own. -->
        <StackPanel x:Name="WaitPanel" Visibility="Collapsed" VerticalAlignment="Center">
          <Viewbox Width="34" Height="34" HorizontalAlignment="Center" Opacity="0.72">
            <Canvas Width="24" Height="24">
              <Path Data="{StaticResource IconLockShackle}" Stroke="{StaticResource Muted}"
                    StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="{StaticResource IconLockBody}" Fill="{StaticResource Muted}"/>
            </Canvas>
          </Viewbox>
          <Viewbox MaxWidth="230" Height="62" StretchDirection="DownOnly" Stretch="Uniform"
                   Margin="0,14,0,0">
            <TextBlock x:Name="CountdownText" FontFamily="Consolas" FontSize="54" FontWeight="Bold"/>
          </Viewbox>
        </StackPanel>

        <!-- FINISHED -->
        <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center">
          <Path x:Name="DoneMark" Data="{StaticResource IconCrown}" Width="86" Height="86"
                Stretch="Uniform" HorizontalAlignment="Center"/>
        </StackPanel>

      </Grid>

      <!-- The bonus stone, parked in the empty corner outside the rim. Declared after the face so it
           takes the click; the face is clipped to its own diamond, so the two never fight over one. -->
      <Grid x:Name="Sat" Opacity="0" Cursor="Hand" Background="Transparent"
            MouseLeftButtonUp="Sat_Click" RenderTransformOrigin="0.5,0.5"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Width="120" Height="110" Margin="378,17,0,0">
        <Grid.RenderTransform>
          <ScaleTransform x:Name="SatScale" ScaleX="0.4" ScaleY="0.4"/>
        </Grid.RenderTransform>
        <Path x:Name="SatHalo" Stroke="{StaticResource Ice}" StrokeThickness="4"
              StrokeLineJoin="Round" Opacity="0.3" RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform>
            <ScaleTransform x:Name="SatBeat" ScaleX="1" ScaleY="1"/>
          </Path.RenderTransform>
        </Path>
        <Path x:Name="SatStone" StrokeThickness="2" StrokeLineJoin="Round" Stroke="#EAF7FF"/>
        <Path x:Name="SatFacet" Fill="#4DFFFFFF"/>
      </Grid>
    </Grid>

    <!-- Chrome slides up after the diamond lands -->
    <StackPanel x:Name="Chrome" HorizontalAlignment="Center" Margin="0,18,0,0" Opacity="0">
      <StackPanel.RenderTransform>
        <TranslateTransform x:Name="ChromeRise" Y="22"/>
      </StackPanel.RenderTransform>
      <Button Style="{StaticResource Back}" Click="Back_Click">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconBack}" Width="19" Height="19" Stretch="Uniform"
                StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                StrokeLineJoin="Round" VerticalAlignment="Center"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="BACK" Margin="11,0,0,0" VerticalAlignment="Center"
                     FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                     FontWeight="Bold"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </StackPanel>
      </Button>
    </StackPanel>

  </StackPanel>
</UserControl>
